{
    "name": "huit/schedule-hub",
    "description": "HUIT Schedule Hub - Hệ thống quản lý và phân lịch giảng dạy đa cơ sở thông minh cho Đại học Công Thương TP.HCM",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "HUIT Dev Team",
            "email": "dev@huit.edu.vn"
        }
    ],
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "seed": "php seed.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
